{
  "manifest_version": 3,
  "name": "Brightspace Grasple Layout",
  "version": "1.12.0",
  "description": "Splits Brightspace Grasple content pages into 3 resizable columns: Navigation, Grasple exercise, and Activity Details.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.brightspace.com/*viewContent*",
        "*://*.tudelft.nl/*viewContent*",
        "*://*.brightspace.com/*viewcontent*",
        "*://*.tudelft.nl/*viewcontent*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}
